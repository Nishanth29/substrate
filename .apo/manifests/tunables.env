# Benchmark settings for run_experiment.py (sweperf activation throughput).
#
# Loop settings are locked so trials stay comparable: the agent improves
# throughput with code changes in the allowed scope, and Study K tunes only
# the knobs marked status=tuning at the bottom.

# --- Workload (locked) ---------------------------------------------------------
# Sweperf template and image (astropy-7336, 37 MB compressed / 61 MB
# uncompressed snapshot on the old base). Upstream renamed the template
# swebench-astropy-7336 -> sweperf-astropy-7336; the harness creates it from
# manifests/sweperf-template.yaml.tmpl (same image and command as upstream's
# generated template, limits from ACTOR_CPU / ACTOR_MEMORY below).
export TEMPLATE=sweperf-astropy-7336
export SWEPERF_IMAGE=us-docker.pkg.dev/gke-substrate-release/benchmark/sweperf@sha256:c265bfba3bea40c99e7baad734579b75d02dab6dbe6910cb1f9ed71c8b08f5b1

# Registered actors and how many of them stay active. Each actor stays active
# for about AWAKE / RATE seconds, so keep AWAKE >= 15 x RATE (sim not the limit).
# 500 keeps rates valid up to ~33/s, which covers the spec target of 30/s (250
# capped us at ~16/s). Same N on both stacks so the spec answer is comparable.
# Phase 1/2 measure memory per actor; if 500 doesn't fit the node, fall back to
# 250 and record that the spec can't be tested above ~16/s.
# OPTUNA: name=AWAKE, type=int, min=100, max=650, step=50, status=locked
export AWAKE=500
# 1000, not 2000 (2026-10-22): upstream atelet keeps every suspended actor's
# latest snapshot on the node for --snapshot-detach-delay (114-133 MB each for
# the 2Gi guest; 133 MB measured in smoke attempt 2), and 2000 of them filled
# the 193 GiB boot disk (smoke attempt 1); 1000 used 73.5% of it. check_node_disk
# fails the trial (PREFLIGHT_DISK) when REGISTERED x SNAPSHOT_MB_PER_ACTOR
# exceeds the free space minus NODE_DISK_RESERVE_MB (kubelet eviction
# threshold ~10% + image cache).
export REGISTERED=1000
export SNAPSHOT_MB_PER_ACTOR=140
export NODE_DISK_RESERVE_MB=30000

# Turnover rate per second for a fixed-rate trial (k parks + k wakes per 1-s
# tick). Set to 80% of the stack's v000 ceiling after the baseline.
# OPTUNA: name=RATE, type=int, min=1, max=40, step=1, status=locked
export RATE=4
export SWAP_EVERY=1s

# Ramp mode (acceptance / ceiling): start, multiplier per level.
export RAMP_START=2
export RAMP_MULT=1.15

# Measurement: warm-up, then WINDOWS windows of WINDOW each.
export WARMUP=2m
export WINDOW=3m
export WINDOWS=3

# Pre-warm: one sweperf step per actor before measuring, so measured wakes
# are warm (the actor's own snapshot, not the golden).
export PREWARM_STEPS=1
export SETUP_CONCURRENCY=32

# Sampled TTFE: this % of wakes also run one sweperf step (side metric).
export TTFE_SAMPLE_PCT=5

# Gates, as in the agents-tco campaign.
export FAIL_ERROR_PCT=0.5
export FAIL_REFUSAL_PCT=0.5
export FAIL_CRASHED=1

# --- Worker layout --------------------------------------------------------------
# benchmark-ateom WorkerPool replicas and CPU request per worker (no limit). A
# worker hosts many actors; slots must cover AWAKE plus swaps in flight.
# OPTUNA: name=WORKER_COUNT, type=int, min=1, max=8, step=1, status=locked
export WORKER_COUNT=4
# OPTUNA: name=WORKER_CPU_REQUEST, type=int, min=16, max=180, step=4, status=locked
export WORKER_CPU_REQUEST=44

# Actor limits (ActorTemplate resources.limits; required upstream since #2285,
# and booked against each worker's capacity). microVM: ACTOR_CPU sets the vCPUs
# (rounded up) and ACTOR_MEMORY the guest size. 1 CPU / 2Gi mirror what the old
# template got without limits (kata's default 2 GiB guest), so the snapshot has
# the same guest size as the Oct 11 campaign; upstream's template uses 2 / 4Gi,
# which doesn't fit AWAKE=500 on one node. (ACTOR_MEMORY=1Gi was never applied
# to the old swebench template.)
# OPTUNA: name=ACTOR_CPU, type=categorical, choices=1|2, status=locked
export ACTOR_CPU=1
# OPTUNA: name=ACTOR_MEMORY, type=categorical, choices=1Gi|2Gi|4Gi, status=locked
export ACTOR_MEMORY=2Gi

# --- Lifecycle (locked) ------------------------------------------------------------
# agentsim --lifecycle-mode. suspend = SuspendActor with no suspend_options,
# which upstream now completes asynchronously (#2805): the call returns once the
# actor is down and the durable upload finishes in the background; a resume on
# the same node may restore the local copy (#2883/#2967). pause no longer exists
# upstream (#2813). Recorded in summary.json metadata.
export LIFECYCLE_MODE=suspend

# atelet --snapshot-detach-delay: how long a suspended actor's latest snapshot
# stays on the node before atelet detaches it. Empty = upstream default (30m):
# on one node nearly every warm wake restores the node-local copy (Phase 1 arm
# "local"). 2m = the "gcs" arm: copies are dropped soon after the upload, so
# wakes mostly download from GCS. Applied to the atelet DaemonSet each trial.
# Locked; no OPTUNA annotation since the default is the empty value.
export ATELET_SNAPSHOT_DETACH_DELAY=

# --- Node knobs (Study K) --------------------------------------------------------
# Applied by run_experiment.py through the apo-nodeshell pod (manifests/nodeshell.yaml.tmpl).
# OPTUNA: name=NODE_TMPFS_ACTORS, type=categorical, choices=true|false, status=locked
export NODE_TMPFS_ACTORS=false
# OPTUNA: name=NODE_NEIGH_GC_THRESH3, type=int, min=1024, max=65536, step=1024, status=locked
export NODE_NEIGH_GC_THRESH3=1024

# --- Object storage knobs ----------------------------------------------------------
# None on this base. The Study K knobs (ATE_GCS_CLIENT_POOL, ATE_GCS_RANGE_BYTES,
# ATE_GCS_RANGE_INFLIGHT, ATE_ZSTD_CHUNK_BYTES, ATE_ZSTD_DECODER_CONCURRENCY,
# ATE_ZSTD_LEVEL, GOGC on the snapshot-plugin sidecar) came from Aditya's
# pkg/objectstorage env-knob patch on the old base; upstream main has no such
# env vars (the sidecar is now objectstore-plugin), so setting them would be a
# no-op. run_experiment.py still applies STORAGE_KNOBS on STORAGE_KNOB_TARGETS
# if a lever adds knobs, e.g.
#   STORAGE_KNOBS="ATE_X" STORAGE_KNOB_TARGETS="ate-system/daemonset/ATELET_DS:objectstore-plugin"
export STORAGE_KNOBS=""
export STORAGE_KNOB_TARGETS="ate-system/daemonset/ATELET_DS:objectstore-plugin"
